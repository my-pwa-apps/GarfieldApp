{
  "name": "garfieldapp",
  "version": "1.0.15",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "description": "Daily Garfield Comics — a vanilla-JavaScript Progressive Web App with English/Spanish strips, offline caching, favorites sync and a community leaderboard.",
  "scripts": {
    "test:lint": "eslint . --quiet",
    "serve": "node tests/support/static-server.cjs --host 127.0.0.1 --port 8000",
    "test": "npm run test:unit && playwright test",
    "test:cross-browser": "playwright test --config=playwright.cross-browser.config.cjs",
    "test:e2e": "playwright test",
    "test:native": "playwright test --config=playwright.native.config.cjs",
    "test:lighthouse": "node tests/support/lighthouse-audit.cjs",
    "test:first-visit": "playwright test tests/e2e/recommended.spec.cjs --grep \"first visit\"",
    "test:workers": "node tests/support/live-worker-health.cjs",
    "bump:version": "node tools/bump-version.cjs",
    "indexnow": "node tools/indexnow.cjs",
    "test:assets": "node tools/verify-assets.cjs",
    "test:predeploy": "npm run test:lint && npm run test:syntax && npm run test:assets && npm run test:unit && playwright test --project=chromium --workers=1 && playwright test --project=mobile-chrome --workers=1 && npm run test:cross-browser -- --workers=1 && npm run test:lighthouse && npm run test:workers",
    "test:pwa": "playwright test tests/e2e/pwa-offline.spec.cjs --project=chromium",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:usability": "playwright test tests/e2e/usability.spec.cjs",
    "test:production": "playwright test tests/e2e/production-smoke.spec.cjs",
    "test:headed": "playwright test --headed",
    "test:syntax": "node tools/check-syntax.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "1.59.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "lighthouse": "^13.4.1",
    "miniflare": "5.20260811.1-alpha",
    "wrangler": "^4.123.0"
  }
}
